# Public — safe for the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SERVICE_ROLE_KEY=

# AI provider key, server-only
AI_PROVIDER_API_KEY=

# Set this to your deployed URL once known (used to build WhatsApp share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, no +, no spaces (e.g. 96891234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=96895327499